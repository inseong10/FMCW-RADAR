2026-11-20-e12-4core-*/** -text
2026-11-20-e13-2core-*/** -text
2026-11-20-e13-4core-*/** -text
2026-11-20-e13-bf2-*/** -text
2026-11-21-e13-bf2-*/** -text
2026-11-21-e13-stream-*/** -text
2026-11-21-e14-frame-*/** -text
