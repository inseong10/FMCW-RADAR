// Generated from NumPy FFT; real and imaginary values are signed Q8.
function [15:0] input_sample;
    input [2:0] test_number;
    input [4:0] sample_number;
    begin
        case (test_number)
            0: input_sample = 16'd0;
            1: input_sample = sample_number == 0 ? 16'd256 : 16'd0;
            2: input_sample = 16'd256;
            3: input_sample = sample_number == 1 ? 16'd256 : 16'd0;
            4: begin
                case (sample_number)
                    5'd0: input_sample = 16'h0100;
                    5'd1: input_sample = 16'h0000;
                    5'd2: input_sample = 16'h0200;
                    5'd3: input_sample = 16'h0100;
                    5'd4: input_sample = 16'h0000;
                    5'd5: input_sample = 16'h0200;
                    5'd6: input_sample = 16'h0100;
                    5'd7: input_sample = 16'h0000;
                    5'd8: input_sample = 16'h0200;
                    5'd9: input_sample = 16'h0100;
                    5'd10: input_sample = 16'h0000;
                    5'd11: input_sample = 16'h0200;
                    5'd12: input_sample = 16'h0100;
                    5'd13: input_sample = 16'h0000;
                    5'd14: input_sample = 16'h0200;
                    5'd15: input_sample = 16'h0100;
                    5'd16: input_sample = 16'h0000;
                    5'd17: input_sample = 16'h0200;
                    5'd18: input_sample = 16'h0100;
                    5'd19: input_sample = 16'h0000;
                    5'd20: input_sample = 16'h0200;
                    5'd21: input_sample = 16'h0100;
                    5'd22: input_sample = 16'h0000;
                    5'd23: input_sample = 16'h0200;
                    5'd24: input_sample = 16'h0100;
                    5'd25: input_sample = 16'h0000;
                    5'd26: input_sample = 16'h0200;
                    5'd27: input_sample = 16'h0100;
                    5'd28: input_sample = 16'h0000;
                    5'd29: input_sample = 16'h0200;
                    5'd30: input_sample = 16'h0100;
                    5'd31: input_sample = 16'h0000;
                    default: input_sample = 0;
                endcase
            end
            default: input_sample = 0;
        endcase
    end
endfunction

